# Bu faylni nusxalab, nomini .env qiling va qiymatlarni to'ldiring.
# .env fayli GitHub'ga YUKLANMAYDI (.gitignore ichida).

# Telegram bot tokeni — @BotFather beradi
BOT_TOKEN=

# DeepSeek API kaliti — matn yaratish uchun (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Google Gemini API kaliti — rasm/PDF o'qish va masala yechish (https://aistudio.google.com)
GEMINI_API_KEY=

# Admin Telegram ID raqami (@userinfobot orqali bilish mumkin)
ADMIN_ID=

# Log kanali ID si (ixtiyoriy, masalan -1001234567890). 0 = o'chirilgan
LOG_CHANNEL_ID=0

# To'lov uchun karta ma'lumotlari (ixtiyoriy)
CARD_NUMBER=
CARD_OWNER=

# ── Bulut baza (Render kabi bepul hostinglar uchun) ──
# Render'da avtomatik yoqiladi. Boshqa joyda yoqish uchun: CLOUD_DB=1
# Baza saqlanadigan chat ID si. Bo'sh qolsa — admin bilan shaxsiy chat ishlatiladi.
DB_CHAT_ID=
CLOUD_DB=
